{
  "appId": "com.gigahertz.saleskit.server",
  "productName": "GigaHertz SalesKit Server",
  "extraMetadata": {
    "name": "saleskit-server",
    "version": "1.0.22",
    "main": "server/main.js"
  },
  "directories": {
    "output": "dist-server"
  },
  "files": [
    "server/**/*",
    "electron/database.js",
    "electron/sheets-sync.js",
    "electron/local-api.js",
    "electron/banner-data.js",
    "electron/feature-banners.js",
    "electron/ageing-banners.js",
    "electron/app-usability.js",
    "electron/branch-details.js",
    "electron/reco-db.js",
    "electron/embedded-config.json",
    "package.json",
    "!node_modules/html2canvas{,/**/*}",
    "!node_modules/@fontsource/outfit{,/**/*}"
  ],
  "extraResources": [
    {
      "from": "mydata.db",
      "to": "mydata.db"
    }
  ],
  "publish": {
    "provider": "generic",
    "url": "https://github.com/drewgigahertz-ai/GSP-Sales-Kit/releases/download/server-updates",
    "channel": "server"
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SalesKit Server",
    "artifactName": "GigaHertz-SalesKit-Server-Setup-${version}.${ext}"
  }
}
