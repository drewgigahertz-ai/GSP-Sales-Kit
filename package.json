{
  "name": "saleskit-desktop",
  "version": "1.0.6",
  "private": true,
  "description": "GigaHertz SalesKit desktop application",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "node scripts/check-release.js && electron-builder --win nsis --publish never && node scripts/publish-release.js && node scripts/verify-release.js",
    "verify-release": "node scripts/verify-release.js",
    "start:server": "electron server/main.js",
    "dist:server": "electron-builder --config server-builder.json --win nsis --publish never",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "better-sqlite3": "^12.2.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "electron-updater": "^6.8.9",
    "googleapis": "^183.0.0",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gigahertz.saleskit",
    "productName": "GigaHertz SalesKit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "!electron/embedded-config.example.json",
      "!electron/database.js",
      "!electron/sheets-sync.js",
      "!electron/local-api.js",
      "!node_modules/googleapis{,/**/*}",
      "!node_modules/better-sqlite3{,/**/*}",
      "saleskit.html",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "drewgigahertz-ai",
      "repo": "GSP-Sales-Kit",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
